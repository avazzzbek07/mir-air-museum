rules_version = '2';

// MIR×AIR site data.
//   profiles/{uid}   student profile; the owner edits, the group's starosta approves
//   projects/{id}    project submitted by a student (text + small cover); the group's starosta approves
//   projectPhotos/{id} full-size photos of projects/{id}, loaded only on the project page
//   likes/{id}       one like per account per project (id = projectId + "_" + uid; visitors get an anonymous account)
//   likeCounts/{id}  like counter per project
//   news/{id}        news and events, written by starostas
//
// Moderators are listed by verified email. "all" may moderate every group.
service cloud.firestore {
  match /databases/{database}/documents {

    function moderators() {
      return {
        'avazbek.madrakhimovw@gmail.com': 'all'
      };
    }
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function modScope() {
      return verified() && request.auth.token.email in moderators()
        ? moderators()[request.auth.token.email] : '';
    }
    function isMod() { return modScope() != ''; }
    function modOf(group) { return modScope() == 'all' || modScope() == group; }

    function groupId(g) { return g in ['mir-1', 'mir-2', 'mir-3']; }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || str(d[k], max); }
    function strList(v, maxItems) { return v is list && v.size() <= maxItems; }
    // a compressed JPEG data URL; Firestore documents are capped at 1 MiB in total
    function photo(v, max) { return v is string && v.size() <= max && (v.size() == 0 || v.matches('^data:image/(jpeg|png|webp);base64,.*')); }
    function photoList(l, max) {
      return l is list && l.size() <= 3
        && (l.size() < 1 || photo(l[0], max)) && (l.size() < 2 || photo(l[1], max)) && (l.size() < 3 || photo(l[2], max));
    }
    function contactsOk(c) {
      return c is map && c.keys().hasOnly(['telegram', 'github', 'email', 'linkedin', 'site'])
        && optStr(c, 'telegram', 120) && optStr(c, 'github', 120) && optStr(c, 'email', 120) && optStr(c, 'linkedin', 120) && optStr(c, 'site', 120);
    }

    // ---------- profiles ----------
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'group', 'bio', 'skills', 'internship', 'contacts', 'photo', 'status', 'updatedAt', 'createdAt'])
        && str(d.name, 80) && d.name.size() > 3 && groupId(d.group)
        && optStr(d, 'bio', 600)
        && strList(d.skills, 20)
        && d.internship is bool
        && contactsOk(d.contacts)
        && photo(d.photo, 200000)
        && d.status in ['pending', 'approved', 'rejected']
        && d.updatedAt == request.time;
    }
    match /profiles/{uid} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && request.auth.uid == uid)
        || modOf(resource.data.group);
      // the owner creates at sign-up (email not confirmed yet) and edits once confirmed; every edit goes back to review
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data) && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && request.auth.uid == uid
        && validProfile(request.resource.data) && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt;
      // the starosta of the group approves or rejects without touching the content
      allow update: if modOf(resource.data.group)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if (signedIn() && request.auth.uid == uid) || modOf(resource.data.group);
    }

    // ---------- projects ----------
    function validProject(d) {
      return d.keys().hasOnly(['title', 'desc', 'group', 'groups', 'type', 'stage', 'tags', 'authors', 'photos', 'cover', 'demo', 'repo', 'problem', 'solution', 'result', 'ownerUid', 'status', 'createdAt', 'updatedAt'])
        && str(d.title, 120) && d.title.size() > 2
        && str(d.desc, 600)
        && groupId(d.group) && d.groups is list && d.groups.size() >= 1 && d.groups.size() <= 3 && d.groups[0] == d.group
        && d.type in ['project', 'demo', 'site', 'idea']
        && d.stage in ['idea', 'work', 'demo']
        && strList(d.tags, 12)
        && str(d.authors, 300)
        && (!('photos' in d) || photoList(d.photos, 220000))
        && (!('cover' in d) || photo(d.cover, 100000))
        && optStr(d, 'demo', 300) && optStr(d, 'repo', 300)
        && optStr(d, 'problem', 800) && optStr(d, 'solution', 1200) && optStr(d, 'result', 800)
        && d.status in ['pending', 'approved', 'rejected']
        && d.updatedAt == request.time;
    }
    match /projects/{id} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && request.auth.uid == resource.data.ownerUid)
        || modOf(resource.data.group);
      allow create: if verified() && validProject(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && request.auth.uid == resource.data.ownerUid
        && validProject(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt;
      allow update: if modOf(resource.data.group)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if (signedIn() && request.auth.uid == resource.data.ownerUid) || modOf(resource.data.group);
    }

    match /projectPhotos/{id} {
      function proj() { return get(/databases/$(database)/documents/projects/$(id)).data; }
      allow read: if proj().status == 'approved'
        || (signedIn() && request.auth.uid == proj().ownerUid)
        || modOf(proj().group);
      // written in the same batch as the project itself
      allow create, update: if verified()
        && getAfter(/databases/$(database)/documents/projects/$(id)).data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['photos']) && photoList(request.resource.data.photos, 220000);
      allow delete: if (signedIn() && request.auth.uid == proj().ownerUid) || modOf(proj().group);
    }

    // ---------- likes ----------
    // A like names either a project from data.js (keep this list in sync with ITEMS ids there)
    // or an approved student project ("u-" + document id).
    function likeTarget(p) {
      return p in ['smart-garage', 'esp32-mini-radar', 'digisand', 'starys', 'esp32-rc-car', 'acousticguard', 'auto-trash-bin',
                   'pixie', 'cyberbuddy', 'smartsprout', 'climateguard', 'glove-mouse', 'kamkor', 'sunflower', 'smartflow']
        || (p.matches('^u-[A-Za-z0-9]{1,40}$')
            && get(/databases/$(database)/documents/projects/$(p.replace('^u-', ''))).data.status == 'approved');
    }
    // The document id fixes one like per account per project; likes are never changed or removed.
    // `device` holds the uid (the field kept its old name so earlier likes stay valid).
    match /likes/{likeId} {
      allow get: if signedIn() && likeId.matches('.*_' + request.auth.uid + '$');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['project', 'device', 'at'])
        && request.resource.data.device == request.auth.uid
        && str(request.resource.data.project, 80)
        && likeId == request.resource.data.project + '_' + request.auth.uid
        && request.resource.data.at == request.time
        && likeTarget(request.resource.data.project);
    }
    // Per-project counters. Each +1 must arrive in the same batch as a brand-new like
    // document from the account named in `last`, so a counter can't be raised without a like.
    function newLike(project, device) {
      return signedIn() && device == request.auth.uid
        && existsAfter(/databases/$(database)/documents/likes/$(project + '_' + device))
        && !exists(/databases/$(database)/documents/likes/$(project + '_' + device));
    }
    // `n` counts every like; `v` counts likes from students (confirmed email + approved profile)
    // and is what orders the museum halls, so anonymous likes can't push a project forward.
    function student() {
      return verified() && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.status == 'approved';
    }
    match /likeCounts/{project} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n', 'v', 'last'])
        && request.resource.data.n == 1 && request.resource.data.v == (student() ? 1 : 0)
        && newLike(project, request.resource.data.last);
      allow update: if request.resource.data.keys().hasOnly(['n', 'v', 'last'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.v == resource.data.get('v', 0) + (student() ? 1 : 0)
        && newLike(project, request.resource.data.last);
    }

    // ---------- news and events ----------
    match /news/{id} {
      allow read: if true;
      allow create, update: if isMod()
        && request.resource.data.keys().hasOnly(['kind', 'title', 'text', 'date', 'place', 'link', 'photo', 'groups', 'author', 'createdAt', 'updatedAt'])
        && request.resource.data.kind in ['news', 'event']
        && str(request.resource.data.title, 140) && str(request.resource.data.text, 2000)
        && request.resource.data.date is timestamp
        && optStr(request.resource.data, 'place', 140) && optStr(request.resource.data, 'link', 300)
        && (!('photo' in request.resource.data) || photo(request.resource.data.photo, 400000));
      allow delete: if isMod();
    }
  }
}
